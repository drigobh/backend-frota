# Força quebras de linha LF para todos os arquivos de texto
* text=auto eol=lf

# Arquivos JSON sempre LF, sem conversão
*.json text eol=lf

# JavaScript sempre LF
*.js text eol=lf

# YAML sempre LF
*.yml text eol=lf
*.yaml text eol=lf

# Markdown sempre LF
*.md text eol=lf

# Desabilita LFS para arquivos de texto (evita BOM)
package.json -filter -text
