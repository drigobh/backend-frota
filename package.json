{
  "name": "projeto-caderninho-frota",
  "version": "2.0.0",
  "description": "Sistema Corporativo de Gestao de Frota - Caderninho de Motorista",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env.local src/server.js",
    "dev:watch": "node --watch --env-file=.env.local src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "lint": "node --check src/server.js && node --check src/database.js && node --check src/auto_migrate.js"
  },
  "keywords": [
    "frota",
    "logistica",
    "transporte",
    "dre"
  ],
  "author": "Drigo",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "sharp": "^0.35.4",
    "supertest": "^6.3.4"
  }
}
