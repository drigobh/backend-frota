# ============================================================================
# VARIAVEIS DE AMBIENTE - CADERNINHO DE FROTA
# ============================================================================
# Este arquivo e um TEMPLATE. Copie para .env e preencha com valores reais.
# NUNCA commite o .env real no git.
# ============================================================================

# --- SERVIDOR ---
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# --- BANCO DE DADOS (Neon PostgreSQL) ---
# Formato: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/caderninho?sslmode=require

# --- SEGURANCA ---
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=substitua-por-chave-forte-de-128-caracteres

# --- CORS ---
# Lista separada por virgula de origens autorizadas
CORS_ORIGINS=http://localhost:3000,https://backend-frota-72ni.onrender.com

# --- RATE LIMIT ---
# Em dev/test, use true para pular rate limit
SKIP_RATE_LIMIT=false

# --- EMAIL (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@caderninhofrota.com.br

# --- BACKUP ---
BACKUP_CRON_ENABLED=true

# --- SENTRY (opcional) ---
SENTRY_DSN=
